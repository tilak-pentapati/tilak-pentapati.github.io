// GitHub Codespaces / VS Code dev container for re-running any project page.
// Miniconda base (conda with the libmamba solver) + Quarto 1.10.18, the version
// the site is built with. Each page's environment is built on demand, e.g.
//   scripts/repro/setup-env.sh projects/r/stm_covid
// Raw data is not in the repository: see data/README.md.
{
  "name": "Portfolio reproducibility",
  "image": "mcr.microsoft.com/devcontainers/miniconda:1-3",
  "features": {
    "ghcr.io/rocker-org/devcontainer-features/quarto-cli:1": { "version": "1.10.18" }
  },
  "hostRequirements": { "cpus": 4, "memory": "8gb" },
  "postCreateCommand": "conda config --add channels conda-forge && conda config --set channel_priority strict",
  "customizations": {
    "codespaces": { "openFiles": ["REPRODUCIBILITY.md"] },
    "vscode": {
      "extensions": ["quarto.quarto", "ms-python.python", "REditorSupport.r"]
    }
  }
}
