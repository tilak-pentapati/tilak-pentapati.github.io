#!/usr/bin/env bash
# mybinder.org: runs after binder/environment.yml is installed.
set -euo pipefail

# Quarto CLI, the version the site is built with.
QUARTO_VERSION=1.10.18
mkdir -p "$HOME/.local/bin" "$HOME/.local/opt"
curl -fsSL "https://github.com/quarto-dev/quarto-cli/releases/download/v${QUARTO_VERSION}/quarto-${QUARTO_VERSION}-linux-amd64.tar.gz" \
  | tar -xz -C "$HOME/.local/opt"
ln -sf "$HOME/.local/opt/quarto-${QUARTO_VERSION}/bin/quarto" "$HOME/.local/bin/quarto"

# R packages that are not on conda-forge, pinned per project.
Rscript scripts/repro/install_cran.R projects/r/*/cran-packages.txt
